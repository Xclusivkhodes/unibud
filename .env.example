# Names only. Leave values empty. Do not commit filled secrets.
# UI and live provider calls are not enabled in this milestone.

# SQLite file. Empty uses .data/unibud.sqlite, which is gitignored.
UNIBUD_DB_PATH=

# Upload and device directories. Empty uses .data/uploads and .data/device.
UNIBUD_UPLOAD_DIR=
UNIBUD_DEVICE_DIR=

# Set to 1 only for local HTTP on 127.0.0.1. Otherwise the session cookie is Secure.
UNIBUD_COOKIE_INSECURE=

# Optional comma-separated Gemini or Gemma model ids. Empty keeps live model selection unset.
# Do not put gemini-2.5-flash here. Teammate reports are not a verified default.
UNIBUD_GEMINI_MODELS=

# Server-only provider credentials. Presence marks "configured", not live-verified.
# Google dispatch stays blocked until age/product policy is resolved, even if this is set.
GEMINI_API_KEY=

# Other adapters are implemented as policy gates. Live calls are not authorized.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Loopback-only compatible endpoint. Must be http://127.0.0.1:<port> with no DNS name.
UNIBUD_LOOPBACK_BASE_URL=
UNIBUD_LOOPBACK_MODEL=

# YouTube Data API key. Search is not executed unless a later authorized run allows network.
YOUTUBE_API_KEY=

# SMTP is optional and fail-closed. Empty values do not open a connection.
# Consent links in this build go to the dev outbox, not to SMTP.
UNIBUD_SMTP_HOST=
UNIBUD_SMTP_PORT=
UNIBUD_SMTP_USER=
UNIBUD_SMTP_PASSWORD=
UNIBUD_SMTP_FROM=

# Dev consent files. Empty uses .data/outbox, which is gitignored. Never commit tokens.
UNIBUD_OUTBOX_DIR=

# Admin flag for the verified-teacher stub and the pending-consent purge. Empty disables those routes.
UNIBUD_ADMIN_TOKEN=
