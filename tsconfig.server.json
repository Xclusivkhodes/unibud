{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist-server",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/server/main.ts", "src/server/api.ts", "src/server/appdb.ts", "src/server/http.ts", "src/domain.ts", "src/db.ts", "src/contract/**/*.ts", "src/security/**/*.ts", "src/learning/**/*.ts", "src/providers/**/*.ts", "src/youtube/**/*.ts", "src/device/**/*.ts"]
}
