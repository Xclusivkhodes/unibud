{
  "name": "unibud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "serve": "tsc -p tsconfig.server.json && cp src/schema.sql dist-server/schema.sql && node dist-server/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:backend": "tsc -p tsconfig.server.json --noEmit --pretty false",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "22.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
